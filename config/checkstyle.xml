<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- Проверка именования методов (camelCase) и запрет нижних подчеркиваний -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Проверка именования классов (PascalCase) -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Проверка именования локальных переменных -->
        <module name="LocalVariableName"/>

        <!-- Запрет импортов вида import java.util.*; -->
        <module name="AvoidStarImport"/>

        <!-- Проверка избыточных импортов (например, импорт класса из того же пакета) -->
        <module name="RedundantImport"/>

        <!-- Проверка неиспользуемых импортов -->
        <module name="UnusedImports"/>
    </module>
</module>
